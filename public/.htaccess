Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# Retired catalog categories: match exact paths only, including legacy index.html.
# Before slash/host normalization to send old URLs directly to the final destination.
RewriteRule ^catalog/1c(?:/index\.html|/)?$ https://ai-tehcon.ru/ai-for-1c/ [R=301,L,NE]
RewriteRule ^catalog/(?:marketplace|ecommerce)(?:/index\.html|/)?$ https://ai-tehcon.ru/ai-for-marketplace/ [R=301,L,NE]
RewriteRule ^catalog/content-factory(?:/index\.html|/)?$ https://ai-tehcon.ru/content-factory/ [R=301,L,NE]

# Add the canonical trailing slash before Apache's DirectorySlash can create
# an extra redirect with the wrong protocol behind Timeweb's nginx proxy.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]{1,10}$
RewriteRule ^(.+)$ https://ai-tehcon.ru/$1/ [R=301,L,NE]

# Consolidate every host alias on the non-www production host.
RewriteCond %{HTTP_HOST} !^ai-tehcon\.ru$ [NC]
RewriteRule ^ https://ai-tehcon.ru%{REQUEST_URI} [R=301,L,NE]

# Timeweb terminates TLS at nginx and reports HTTPS to Apache via X-HTTPS.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-HTTPS} !1
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://ai-tehcon.ru%{REQUEST_URI} [R=301,L,NE]
